{{#resume.basics}}
<section id="basics">
    <h1>{{name}}</h1>
    {{#if label}}<div class="label centered">{{label}}</div>{{/if}}
    <div class="contact centered">
        {{#if email~}}
        <span class="vertical-separator">{{wrapMail email}}</span>
        {{~/if}}
        {{#if phone~}}
        <span class="vertical-separator">Mobile: {{phone}}</span>
        {{~/if}}
        {{#if location~}}{{#if location.city~}}{{#if location.region~}}
        <span class="vertical-separator">{{location.city}}, {{location.region}}</span>
        {{~/if}}{{~/if}}{{~/if}}
    </div>
    {{#if profiles.length}}
    <div class="contact centered">
        {{#each profiles}}
        <span class="vertical-separator">
            {{network}}: <a href="{{url}}">{{username}}</a>
        </span>
        {{/each}}
    </div>
    {{/if}}
    {{#if summary}}
    <div class="summary">
        <h2>Summary</h2>
        <p>{{{summary}}}</p>
    </div>
    {{/if}}
</section>
{{/resume.basics}}
